# ==================================
# WIWIGA - Variables d'Environnement
# ==================================
# Copier ce fichier en .env et remplir les valeurs
# NE PAS commiter .env dans git !

# ==================================
# Base de Données PostgreSQL
# ==================================
DATABASE_URL=postgresql://wiwiga_user:wiwiga_password@localhost:8001/wiwiga_dev
TEST_DATABASE_URL=postgresql://wiwiga_user:wiwiga_password@localhost:8001/wiwiga_test
DB_POOL_SIZE=10
DB_TIMEOUT=5000

# ==================================
# Redis
# ==================================
REDIS_URL=redis://localhost:8002
REDIS_HOST=localhost
REDIS_PORT=8002
REDIS_PASSWORD=
REDIS_DB=0

# ==================================
# Authentification JWT (Guardian)
# ==================================
GUARDIAN_SECRET_KEY=votre_secret_key_tres_long_et_securise_ici_32_chars_minimum
GUARDIAN_ISSUER=game_hub
GUARDIAN_TTL_SECONDS=86400

# ==================================
# Paiement Campay
# ==================================
CAMPAY_WEBHOOK_SECRET_KEY=votre_secret_key_campay_ici
CAMPAY_API_URL=https://demo.campay.net/api
CAMPAY_APP_USERNAME=votre_app_username
CAMPAY_APP_PASSWORD=votre_app_password

# ==================================
# Notifications Multi-Canal
# ==================================
# Clé AES-256-GCM (32 octets base64) pour chiffrer les secrets providers.
# Générer avec: openssl rand -base64 32
# OBLIGATOIRE en production (dev/test: clé dérivée par défaut).
NOTIFICATION_CONFIG_KEY=
# Anciennes clés après rotation (séparées par des virgules, déchiffrement seul).
# Procédure : ajouter l'ancienne clé ici, définir la nouvelle ci-dessus,
# redémarrer, lancer `mix notifications.reencrypt_providers`, puis nettoyer.
NOTIFICATION_CONFIG_PREVIOUS_KEYS=

# Les credentials providers (Orange, MTN, eSMS, FCM, SMTP...) se configurent
# EXCLUSIVEMENT depuis l'interface admin (/admin/notification-providers),
# jamais ici ni en variables d'environnement : ils sont persistés en base
# (secrets chiffrés AES-256-GCM via NOTIFICATION_CONFIG_KEY ci-dessus).
# Voir docs/FCM_SETUP.md et docs/NOTIFICATIONS_RUNBOOK.md.
# --- Firebase Web (push navigateur, clés publiques de build) ---
# Config Web Firebase PUBLIQUE (Console → Paramètres projet → Applications Web).
# Utilisée par `wiwiga_app/web/firebase-messaging-sw.js` + build web
# (--dart-define). Ce ne sont PAS des secrets providers : le compte de
# service reste exclusivement côté admin (/admin/notification-providers).
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=wiwiga-d9a7e.firebaseapp.com
# FIREBASE_PROJECT_ID=wiwiga-d9a7e
# FIREBASE_SENDER_ID=660834792043
# FIREBASE_APP_ID=
# Clé VAPID Web Push (Console → Cloud Messaging → Web Push certificates).
# Build web : flutter build web --dart-define=FCM_VAPID_KEY=...
# FCM_VAPID_KEY=

# ==================================
# Environment
# ==================================
MIX_ENV=dev
PORT=4000
SECRET_KEY_BASE=votre_secret_key_base_tres_long_phoenix_ici_minimum_64_chars
LIVE_RELOAD=true

# ==================================
# Production Settings
# ==================================
LOG_LEVEL=info
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ENABLE_HTTPS=false

# ==================================
# Monitoring (Optionnel)
# ==================================
ENABLE_HEALTH_CHECKS=true
ENABLE_METRICS=false
METRICS_PORT=4001
